{
  "name": "claude-session-manager",
  "displayName": "Claude Session & Issue Manager",
  "description": "Quản lý các issue, session, và trạng thái hội thoại của Claude trực tiếp trên VS Code",
  "version": "0.2.1",
  "publisher": "mquand",
  "author": "mquand",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/mquand/Claude-Session-Manager-.git"
  },
  "icon": "resources/icon.png",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other",
    "Productivity"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "claude-session-manager-sidebar",
          "title": "Claude Issues",
          "icon": "resources/icon.svg"
        }
      ]
    },
    "views": {
      "claude-session-manager-sidebar": [
        {
          "type": "webview",
          "id": "claudeSessionManager.issuesView",
          "name": "Claude Issue Sessions"
        }
      ],
      "explorer": [
        {
          "type": "webview",
          "id": "claudeSessionManager.explorerView",
          "name": "Claude Sessions"
        }
      ]
    },
    "commands": [
      {
        "command": "claudeSessionManager.refresh",
        "title": "Làm mới danh sách Sessions",
        "icon": "$(refresh)"
      },
      {
        "command": "claudeSessionManager.openSettings",
        "title": "Cấu hình đường dẫn lưu trữ"
      },
      {
        "command": "claudeSessionManager.checkForUpdates",
        "title": "Kiểm tra bản cập nhật mới (GitHub Releases)",
        "icon": "$(cloud-download)"
      },
      {
        "command": "claudeSessionManager.toggleExplorerView",
        "title": "Bật/Tắt hiển thị Claude Sessions trong thanh Explorer (File Tree)"
      },
      {
        "command": "claudeSessionManager.statusMenu",
        "title": "Menu trạng thái Claude Sessions"
      },
      {
        "command": "claudeSessionManager.openTab",
        "title": "Mở tab lọc Claude Sessions"
      }
    ],
    "configuration": {
      "title": "Claude Session Manager",
      "properties": {
        "claudeSessionManager.storagePath": {
          "type": "string",
          "default": "~/.claude/projects",
          "description": "Đường dẫn chứa lịch sử session hoặc file transcript của Claude"
        },
        "claudeSessionManager.autoRefreshInterval": {
          "type": "number",
          "default": 10,
          "description": "Thời gian tự động quét lại (giây)"
        },
        "claudeSessionManager.language": {
          "type": "string",
          "enum": [
            "auto",
            "vi",
            "en"
          ],
          "default": "auto",
          "description": "Ngôn ngữ hiển thị giao diện (Interface language: auto / vi / en)"
        },
        "claudeSessionManager.showInExplorer": {
          "type": "boolean",
          "default": true,
          "description": "Hiển thị Claude Sessions trong thanh Explorer (File Tree) bên cạnh Open Editors, Timeline... / Show Claude Sessions in the Explorer view"
        },
        "claudeSessionManager.workspaceRoot": {
          "type": "string",
          "default": "",
          "description": "Đường dẫn thư mục chứa các dự án/repository (Workspace root folder). Để trống để tự động nhận diện theo thư mục đang mở trong VS Code."
        },
        "claudeSessionManager.defaultRepo": {
          "type": "string",
          "default": "",
          "description": "Tên repository mặc định khi phiên làm việc không xác định được dự án cụ thể."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.85.0",
    "typescript": "^5.3.3"
  }
}
